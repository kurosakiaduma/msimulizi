# .env.example — copy to .env and fill in real values before running locally.
# Production values are sourced from Azure Key Vault via managed identity.
# NEVER commit .env to the repository.

# ---------------------------------------------------------------------------
# Azure identity (local dev only — prod Container App uses managed identity)
# ---------------------------------------------------------------------------
AZURE_CLIENT_ID=                        # user-assigned managed identity client ID
AZURE_TENANT_ID=                        # Azure AD tenant ID
AZURE_CLIENT_SECRET=                    # service-principal only; leave blank with MI

# ---------------------------------------------------------------------------
# Azure Key Vault
# ---------------------------------------------------------------------------
KEY_VAULT_URL=https://<prefix>-kv.vault.azure.net/

# ---------------------------------------------------------------------------
# Cosmos DB
# ---------------------------------------------------------------------------
COSMOS_ENDPOINT=https://<prefix>-cosmos.documents.azure.com:443/
COSMOS_DATABASE=msimulizi
# Local emulator key (leave commented in prod — MI is used instead):
# COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMcZcLU==

# ---------------------------------------------------------------------------
# Microsoft AI Foundry (Azure OpenAI)
# ---------------------------------------------------------------------------
FOUNDRY_ENDPOINT=https://<prefix>-foundry.openai.azure.com/
FOUNDRY_API_VERSION=2024-08-01-preview
# Local dev only — in prod MI is used:
# FOUNDRY_API_KEY=

# ---------------------------------------------------------------------------
# Azure AI Speech
# ---------------------------------------------------------------------------
SPEECH_ENDPOINT=https://<prefix>-speech.cognitiveservices.azure.com/
# Local dev only:
# SPEECH_API_KEY=

# ---------------------------------------------------------------------------
# Azure AI Content Safety
# ---------------------------------------------------------------------------
CONTENT_SAFETY_ENDPOINT=https://<prefix>-cs.cognitiveservices.azure.com/
# Local dev only:
# CONTENT_SAFETY_API_KEY=

# ---------------------------------------------------------------------------
# Azure Blob Storage (audio)
# ---------------------------------------------------------------------------
STORAGE_ACCOUNT_URL=https://<prefix>stor.blob.core.windows.net/
AUDIO_CONTAINER=audio

# ---------------------------------------------------------------------------
# Application Insights — OpenTelemetry export target (task 29)
# When set, card_latency_ms, audio_latency_ms, verdict counts, fallback_count,
# and quota_exceeded_count are exported to Azure Monitor.
# ---------------------------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# ---------------------------------------------------------------------------
# Pipeline / app settings
# ---------------------------------------------------------------------------
ENVIRONMENT_NAME=dev                    # dev | staging | prod

# Event source adapter: inprocess | file | eventhubs
EVENT_SOURCE=inprocess

# Azure Event Hubs (only required when EVENT_SOURCE=eventhubs)
# EVENT_HUBS_CONNECTION_STRING=
# EVENT_HUBS_NAME=msimulizi-events

# Concurrent session cap and idle timeout
MSIMULIZI_MAX_SESSIONS=8
MSIMULIZI_IDLE_TIMEOUT_SECONDS=600

# Per-IP request rate limit (requests per 60 s window)
MSIMULIZI_PER_IP_RATE_LIMIT=120

# LLM rate limits (calls per minute / per day — 0 = unlimited)
LLM_RATE_LIMIT_PER_MINUTE=60
LLM_RATE_LIMIT_PER_DAY=0

# Speech rate limits
SPEECH_RATE_LIMIT_PER_MINUTE=30
SPEECH_RATE_LIMIT_PER_DAY=0

# WebSocket per-IP connection limit
WS_MAX_CONNECTIONS_PER_IP=5

# Pipeline lookahead in match seconds
PIPELINE_LOOKAHEAD_SECONDS=10

# ---------------------------------------------------------------------------
# API security
# Values come from Key Vault in prod; set here for local dev only.
# ---------------------------------------------------------------------------
MCP_API_KEY=dev-mcp-key-change-me
REVIEWER_API_KEY=dev-reviewer-key-change-me
MSIMULIZI_REVIEWER_KEY=dev-reviewer-key-change-me   # used by /v1/review and audit routes

# ---------------------------------------------------------------------------
# CORS — set to exact deployed frontend URL in prod; * is fine for local dev
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGIN=*
MSIMULIZI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Frontend (Next.js) — consumed by the backend at build time via NEXT_PUBLIC_
# These belong in frontend/.env.local for the Next.js app;
# they are listed here for reference so you copy both together after azd up.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# NEXT_PUBLIC_API_BASE=http://localhost:8000    # used by /review page fetch calls

# ---------------------------------------------------------------------------
# Groundedness eval (scripts/run_groundedness_eval.py)
# Leave unset to run heuristic-only mode (no Azure calls needed).
# Set to run azure-ai-evaluation SDK mode.
# ---------------------------------------------------------------------------
# AZURE_EVAL_DEPLOYMENT=gpt-4o

# ---------------------------------------------------------------------------
# Post-deploy verification (scripts/verify_azure_deployment.py)
# Fill in after `azd up`.
# ---------------------------------------------------------------------------
# SPEECH_API_KEY=
# FOUNDRY_API_KEY=
