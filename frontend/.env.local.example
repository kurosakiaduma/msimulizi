# frontend/.env.local.example
# Copy to frontend/.env.local and fill in values.
# NEXT_PUBLIC_ vars are inlined at build time — do not put secrets here.

# Backend base URL (no trailing slash)
# Local dev:
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# After azd up, replace with your Container App URL:
# NEXT_PUBLIC_BACKEND_URL=https://<app>.azurecontainerapps.io

# WebSocket endpoint
# Local dev:
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# After azd up:
# NEXT_PUBLIC_WS_URL=wss://<app>.azurecontainerapps.io/ws

# Base URL used by the /review page fetch calls (same as BACKEND_URL)
NEXT_PUBLIC_API_BASE=http://localhost:8000
# After azd up:
# NEXT_PUBLIC_API_BASE=https://<app>.azurecontainerapps.io
