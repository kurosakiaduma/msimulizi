# ── Msimulizi backend container image ──
# Context: repository root.  Builds the FastAPI service and runs it under uvicorn.
# Deployed to Azure Container Apps with minReplicas=1, scale-to-zero disabled
# (see infra/main.bicep) so in-memory session state survives.

FROM python:3.13-slim
RUN pip install --no-cache-dir "pip @ https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl#sha256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8000

WORKDIR /app

# System packages: build tools only (kept minimal; wheels are preferred).
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Copy application code first: the editable install resolves the package
# directories listed in pyproject.toml and reads README.md as project metadata.
COPY shared ./shared
COPY generator ./generator
COPY adapter ./adapter
COPY pipeline ./pipeline
COPY renderer ./renderer
COPY api ./api
COPY mcp_server ./mcp_server
COPY explainer ./explainer
COPY config ./config
COPY bundle ./bundle
COPY scripts ./scripts
COPY LICENSE README.md DATA_PROVENANCE.md ./
COPY pyproject.toml uv.lock ./

# Editable install keeps `config/foundry_models.yaml` resolvable from /app.
RUN pip install --upgrade pip setuptools wheel \
    && pip install -e .

# Non-root runtime user.
RUN useradd --create-home --shell /bin/bash msimulizi \
    && chown -R msimulizi:msimulizi /app
USER msimulizi

EXPOSE 8000

# Entrypoint: FastAPI app factory exposed by api.main.
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
